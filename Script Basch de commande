#!/usr/bin/env bash

###############################################################################
# Antenna Control Center - Linux CLI
#
# Commande de l'ESP32-ETH01 par HTTP
#
# API utilisée :
#   GET /api/state
#   GET /api/set?relay=X&on=0|1
#
# Exemple :
#   ./antenna.sh status
#   ./antenna.sh on 1
#   ./antenna.sh off 1
#   ./antenna.sh toggle 1
#
# Les relais sont numérotés de 1 à 8 côté utilisateur.
###############################################################################

set -u

###############################################################################
# CONFIGURATION
###############################################################################

# Adresse IP de l'ESP32
ESP_IP="${ESP_IP:-192.168.1.100}"

# Port HTTP
ESP_PORT="${ESP_PORT:-80}"

# Timeout réseau en secondes
TIMEOUT="${TIMEOUT:-3}"

# URL de base
ESP_URL="http://${ESP_IP}:${ESP_PORT}"


###############################################################################
# COULEURS
###############################################################################

if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    RESET='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    CYAN=''
    BOLD=''
    RESET=''
fi


###############################################################################
# VERIFICATION DE CURL
###############################################################################

check_curl()
{
    if ! command -v curl >/dev/null 2>&1; then
        echo "Erreur : curl n'est pas installé."
        echo
        echo "Debian / Ubuntu :"
        echo "  sudo apt install curl"
        exit 1
    fi
}


###############################################################################
# AFFICHAGE DE L'AIDE
###############################################################################

usage()
{
    cat <<EOF

${BOLD}Antenna Control Center - commande ESP32${RESET}

Utilisation :

  $0 status
      Affiche l'état des 8 relais.

  $0 on RELAIS
      Active un relais.

  $0 off RELAIS
      Désactive un relais.

  $0 toggle RELAIS
      Inverse l'état du relais.

  $0 ip ADRESSE_IP
      Utilise une autre adresse IP pour cette commande.

  $0 help
      Affiche cette aide.

Exemples :

  $0 status
  $0 on 1
  $0 off 1
  $0 toggle 4

  $0 ip 192.168.1.50 status
  $0 ip 192.168.1.50 on 3

Configuration par variable d'environnement :

  ESP_IP=192.168.1.50 $0 status

Adresse actuelle :

  $ESP_URL

EOF
}


###############################################################################
# VERIFICATION DU NUMERO DE RELAIS
###############################################################################

check_relay()
{
    local relay="$1"

    if ! [[ "$relay" =~ ^[1-8]$ ]]; then
        echo -e "${RED}Erreur : le relais doit être compris entre 1 et 8.${RESET}"
        exit 1
    fi
}


###############################################################################
# TEST DE COMMUNICATION
###############################################################################

check_connection()
{
    if ! curl \
        --silent \
        --show-error \
        --fail \
        --max-time "$TIMEOUT" \
        "$ESP_URL/" \
        >/dev/null
    then

        echo -e "${RED}Erreur : ESP32 inaccessible.${RESET}"
        echo
        echo "Adresse testée : $ESP_URL"
        echo
        echo "Vérifie :"
        echo "  - l'adresse IP"
        echo "  - le câble Ethernet"
        echo "  - le réseau"
        echo "  - que l'ESP32 est démarré"
        exit 1
    fi
}


###############################################################################
# RECUPERATION DE L'ETAT
###############################################################################

get_state()
{
    curl \
        --silent \
        --show-error \
        --fail \
        --max-time "$TIMEOUT" \
        "$ESP_URL/api/state"
}


###############################################################################
# AFFICHAGE DE L'ETAT
###############################################################################

show_status()
{
    local json

    json="$(get_state)" || {
        echo -e "${RED}Impossible de récupérer l'état de l'ESP32.${RESET}"
        exit 1
    }

    echo
    echo -e "${BOLD}Antenna Control Center${RESET}"
    echo "ESP32 : $ESP_IP"
    echo
    echo "$json"
    echo
}


###############################################################################
# COMMANDE D'UN RELAIS
###############################################################################

set_relay()
{
    local relay="$1"
    local state="$2"

    check_relay "$relay"

    # L'ESP utilise des index de 0 à 7.
    local index=$((relay - 1))

    local result

    result="$(
        curl \
            --silent \
            --show-error \
            --fail \
            --max-time "$TIMEOUT" \
            "${ESP_URL}/api/set?relay=${index}&on=${state}"
    )" || {
        echo -e "${RED}Erreur de communication avec l'ESP32.${RESET}"
        exit 1
    }

    if [[ "$state" == "1" ]]; then
        echo -e "${GREEN}Relais ${relay} activé.${RESET}"
    else
        echo -e "${YELLOW}Relais ${relay} désactivé.${RESET}"
    fi

    echo
    echo "$result"
    echo
}


###############################################################################
# TOGGLE
###############################################################################

toggle_relay()
{
    local relay="$1"

    check_relay "$relay"

    local index=$((relay - 1))
    local json

    json="$(get_state)" || {
        echo -e "${RED}Impossible de récupérer l'état.${RESET}"
        exit 1
    }

    # On utilise Python si disponible pour lire proprement le JSON.
    if command -v python3 >/dev/null 2>&1; then

        local name
        local current

        name="$(
            python3 - "$json" "$index" <<'PY'
import json
import sys

data = json.loads(sys.argv[1])
index = int(sys.argv[2])

keys = list(data.keys())

if index >= len(keys):
    sys.exit(1)

name = keys[index]
state = bool(data[name])

print(name)
print("1" if state else "0")
PY
        )"

        if [[ -z "$name" ]]; then
            echo -e "${RED}Impossible de lire l'état du relais.${RESET}"
            exit 1
        fi

        local relay_name
        local current_state

        relay_name="$(echo "$name" | sed -n '1p')"
        current_state="$(echo "$name" | sed -n '2p')"

        if [[ "$current_state" == "1" ]]; then
            set_relay "$relay" 0
        else
            set_relay "$relay" 1
        fi

    else

        echo "Python3 n'est pas installé."
        echo "Utilise 'on' ou 'off' directement."
        exit 1

    fi
}


###############################################################################
# POINT D'ENTREE
###############################################################################

check_curl

if [[ $# -eq 0 ]]; then
    usage
    exit 0
fi


###############################################################################
# OPTION IP
###############################################################################

if [[ "$1" == "ip" ]]; then

    if [[ $# -lt 3 ]]; then
        echo "Usage : $0 ip ADRESSE_IP COMMANDE [ARGUMENT]"
        exit 1
    fi

    ESP_IP="$2"
    ESP_URL="http://${ESP_IP}:${ESP_PORT}"

    shift 2
fi


###############################################################################
# COMMANDES
###############################################################################

case "$1" in

    status)

        show_status
        ;;

    on)

        if [[ $# -ne 2 ]]; then
            echo "Usage : $0 on RELAIS"
            exit 1
        fi

        set_relay "$2" 1
        ;;

    off)

        if [[ $# -ne 2 ]]; then
            echo "Usage : $0 off RELAIS"
            exit 1
        fi

        set_relay "$2" 0
        ;;

    toggle)

        if [[ $# -ne 2 ]]; then
            echo "Usage : $0 toggle RELAIS"
            exit 1
        fi

        toggle_relay "$2"
        ;;

    help|-h|--help)

        usage
        ;;

    *)

        echo -e "${RED}Commande inconnue : $1${RESET}"
        usage
        exit 1
        ;;

esac
